{
  "name": "hesabyar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "نرم‌افزار حسابداری فروشگاهی حساب‌یار",
  "author": "Hesabyar",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite dev --port 5173\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:start": "npm run build && electron .",
    "rebuild": "electron-builder install-app-deps",
    "test": "npm run test:unit && npm run test:core",
    "test:unit": "node --test tests/domain.test.js",
    "test:core": "electron scripts/test-core.cjs",
    "test:ui": "electron scripts/smoke.cjs",
    "shots": "npm run build && electron scripts/shot.cjs",
    "check:warnings": "electron scripts/warnings.cjs",
    "verify": "npm run lint && npm run test:unit && npm run test:core && npm run build && npm run test:ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "electron-builder install-app-deps || echo REBUILD_SKIPPED"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.20.0",
    "svelte-eslint-parser": "^1.10.1",
    "tailwindcss": "^4.1.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "build": {
    "appId": "ir.hesabyar.app",
    "productName": "Hesabyar",
    "copyright": "Hesabyar",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "build/**/*",
      "shared/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hesabyar",
      "artifactName": "Hesabyar-Setup-${version}.${ext}"
    }
  }
}
